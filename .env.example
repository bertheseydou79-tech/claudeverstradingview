# Copie ce fichier en .env et remplis les valeurs. NE LE COMMITE JAMAIS.

# Secret partage avec TradingView (invente une longue chaine aleatoire)
WEBHOOK_SECRET=change_moi_par_une_longue_chaine_aleatoire

# Cle API Claude (console.anthropic.com) — reste SUR LE SERVEUR
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789

# Regles (optionnel — valeurs par defaut si absent)
MIN_SCORE=70
MIN_TP1_R=1.5

# Durcissement au serveur (rejet dur) — active seulement ce que tu veux
# HTF seul recommande pour commencer :
STRICT_HTF=1
STRICT_PD=0
STRICT_GRADE=0
